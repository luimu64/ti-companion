# TI-Nspire USB access for non-root users.
#
# Install to /etc/udev/rules.d/99-ti-nspire.rules and reload:
#   sudo install -m 644 99-ti-nspire.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
#
# Classic Nspire / Nspire CX (bulk NavNet transport).
SUBSYSTEM=="usb", ATTR{idVendor}=="0451", ATTR{idProduct}=="e012", MODE="0666", TAG+="uaccess"
# TI-Nspire CX II (NNSE transport).
SUBSYSTEM=="usb", ATTR{idVendor}=="0451", ATTR{idProduct}=="e022", MODE="0666", TAG+="uaccess"
